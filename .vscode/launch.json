{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SMIT - HTTPS (browser auto-open)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/SMITFeeReimbursementSystem/bin/Debug/net10.0/SMITFeeReimbursementSystem.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SMITFeeReimbursementSystem",
      "stopAtEntry": false,
      "launchBrowser": {
        "enabled": true,
        "args": "${auto-detect-url}",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start ${auto-detect-url}"
        }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7055;http://localhost:5055"
      }
    },
    {
      "name": "SMIT - HTTP only",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/SMITFeeReimbursementSystem/bin/Debug/net10.0/SMITFeeReimbursementSystem.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SMITFeeReimbursementSystem",
      "stopAtEntry": false,
      "launchBrowser": {
        "enabled": true,
        "args": "${auto-detect-url}",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start ${auto-detect-url}"
        }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5055"
      }
    }
  ]
}
