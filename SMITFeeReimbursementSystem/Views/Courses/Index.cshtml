@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.CourseListItemViewModel>
@{
    ViewData["Title"] = "Courses";
}

<partial name="_StatusMessage" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 text-primary mb-0">Course Management</h1>
    <a class="btn btn-primary" asp-action="Create">Add Course</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, duration, or description..." />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary me-2">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course</th>
                    <th>Fee</th>
                    <th>Duration</th>
                    <th>Students</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No courses found.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.CourseName</strong>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <div class="small text-muted">@(item.Description.Length > 60 ? item.Description[..60] + "..." : item.Description)</div>
                        }
                    </td>
                    <td>Rs. @item.FeeAmount.ToString("N0")</td>
                    <td>@item.Duration</td>
                    <td><span class="badge bg-secondary">@item.EnrolledCount</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-sm btn-outline-success" asp-action="AssignStudents" asp-route-id="@item.Id">Assign</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
