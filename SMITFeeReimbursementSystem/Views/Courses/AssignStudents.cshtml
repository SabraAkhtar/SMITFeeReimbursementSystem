@model SMITFeeReimbursementSystem.ViewModels.AssignStudentsViewModel
@{
    ViewData["Title"] = "Assign Students";
    Layout = "_AdminLayout";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Assign Students</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">
            Course: <strong style="color:#2ecc71;">@Model.CourseName</strong>
        </p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Course
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="AssignStudents" method="post" data-loading="true">
            <input type="hidden" asp-for="CourseId" />
            <input type="hidden" asp-for="CourseName" />
            <div class="card admin-table-card">
                <div class="card-header d-flex justify-content-between align-items-center" style="padding:1rem 1.25rem;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-graduate" style="color:#2ecc71;"></i>
                        <span style="font-weight:700;">Select Students</span>
                    </div>
                    @if (Model.AvailableStudents.Any())
                    {
                        <span class="badge" style="background:rgba(59,130,246,0.1);color:#3b82f6;font-size:0.75rem;">
                            @Model.AvailableStudents.Count total student(s)
                        </span>
                    }
                </div>
                <div class="card-body p-4">
                    @if (!Model.AvailableStudents.Any())
                    {
                        <div class="text-center py-4" style="color:#94a3b8;">
                            <i class="fa-solid fa-user-slash fa-2x mb-3 d-block" style="opacity:0.3;"></i>
                            <p class="mb-0">No students registered yet. Register users with the Student role first.</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text" style="background:#f8fafc;border:1.5px solid #e2e8f0;border-right:none;">
                                    <i class="fa-solid fa-magnifying-glass text-muted fa-sm"></i>
                                </span>
                                <input type="text" id="studentSearch" class="form-control"
                                       style="border-left:none;"
                                       placeholder="Filter students by name..." />
                            </div>
                        </div>
                        <div class="list-group" id="studentList" style="max-height: 420px; overflow-y: auto; border-radius:0.75rem;border:1.5px solid #e2e8f0;">
                            @foreach (var student in Model.AvailableStudents)
                            {
                                var isChecked = Model.SelectedStudentIds.Contains(student.Id);
                                <label class="list-group-item list-group-item-action d-flex gap-3 align-items-center student-item py-3"
                                       style="cursor:pointer;transition:background 0.15s;@(isChecked ? "background:rgba(46,204,113,0.04);" : "")">
                                    <input type="checkbox" name="SelectedStudentIds" value="@student.Id"
                                           class="form-check-input flex-shrink-0 mt-0"
                                           @(isChecked ? "checked" : "") />
                                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                                        <div style="width:34px;height:34px;border-radius:50%;background:rgba(46,204,113,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i class="fa-solid fa-user fa-xs" style="color:#2ecc71;"></i>
                                        </div>
                                        <span style="font-weight:500;font-size:0.875rem;">@student.Name</span>
                                    </div>
                                    @if (isChecked)
                                    {
                                        <span class="badge" style="background:rgba(46,204,113,0.1);color:#2ecc71;border:1px solid rgba(46,204,113,0.2);font-size:0.7rem;">Enrolled</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Save Assignments
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-xmark me-1"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('studentSearch')?.addEventListener('input', function (e) {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('.student-item').forEach(el => {
            el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script>
}
