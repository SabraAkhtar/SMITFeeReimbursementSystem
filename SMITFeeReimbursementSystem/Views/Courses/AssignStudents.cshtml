@model SMITFeeReimbursementSystem.ViewModels.AssignStudentsViewModel
@{
    ViewData["Title"] = "Assign Students";
}

<h1 class="h2 text-primary mb-1">Assign Students</h1>
<p class="text-muted mb-4">Course: <strong>@Model.CourseName</strong></p>

<form asp-action="AssignStudents" method="post" class="card border-0 shadow-sm">
    <input type="hidden" asp-for="CourseId" />
    <input type="hidden" asp-for="CourseName" />
    <div class="card-body">
        @if (!Model.AvailableStudents.Any())
        {
            <p class="text-muted">No students registered in the system. Register users with the Student role first.</p>
        }
        else
        {
            <div class="mb-3">
                <input type="text" id="studentSearch" class="form-control" placeholder="Filter students..." />
            </div>
            <div class="list-group" id="studentList" style="max-height: 400px; overflow-y: auto;">
                @foreach (var student in Model.AvailableStudents)
                {
                    <label class="list-group-item d-flex gap-2 align-items-center student-item">
                        <input type="checkbox" name="SelectedStudentIds" value="@student.Id"
                               @(Model.SelectedStudentIds.Contains(student.Id) ? "checked" : "") />
                        <span>@student.Name</span>
                    </label>
                }
            </div>
        }
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Assignments</button>
            <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
<script>
    document.getElementById('studentSearch')?.addEventListener('input', function (e) {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('.student-item').forEach(el => {
            el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script>
}
