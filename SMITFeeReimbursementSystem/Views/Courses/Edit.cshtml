@model SMITFeeReimbursementSystem.ViewModels.CourseViewModel
@{
    ViewData["Title"] = "Edit Course";
}

<h1 class="h2 text-primary mb-4">Edit Course</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post" class="card border-0 shadow-sm">
            <div class="card-body">
                <input type="hidden" asp-for="Id" />
                <partial name="_CourseForm" model="Model" />
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
