@model SMITFeeReimbursementSystem.ViewModels.CourseViewModel
@{
    ViewData["Title"] = "Edit Course";
    Layout = "_AdminLayout";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Edit Course</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">Update the course information below</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Courses
    </a>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Edit" method="post" data-loading="true">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
            <div class="card admin-table-card mb-4">
                <div class="card-header" style="padding:1rem 1.25rem;">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:32px;height:32px;border-radius:8px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-pen" style="color:#3b82f6;font-size:0.85rem;"></i>
                        </div>
                        <span style="font-weight:700;">Course Details</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_CourseForm" model="Model" />
                    <div class="d-flex gap-3 pt-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
