@model SMITFeeReimbursementSystem.Models.Course
@{
    ViewData["Title"] = Model.CourseName;
}

<partial name="_StatusMessage" />

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h2 text-primary">@Model.CourseName</h1>
        <p class="text-muted mb-0">@Model.Duration · Rs. @Model.FeeAmount.ToString("N0")</p>
    </div>
    <div>
        <a class="btn btn-success" asp-action="AssignStudents" asp-route-id="@Model.Id">Assign Students</a>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-primary" asp-action="Index">Back</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h5>Description</h5>
        <p class="mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><strong>Enrolled Students (@Model.Enrollments.Count)</strong></div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Email</th><th>Enrolled</th></tr>
            </thead>
            <tbody>
            @if (!Model.Enrollments.Any())
            {
                <tr><td colspan="3" class="text-muted text-center py-3">No students assigned yet.</td></tr>
            }
            @foreach (var e in Model.Enrollments.OrderBy(x => x.Student.FullName))
            {
                <tr>
                    <td>@(e.Student.FullName ?? "—")</td>
                    <td>@e.Student.Email</td>
                    <td>@e.EnrolledAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
