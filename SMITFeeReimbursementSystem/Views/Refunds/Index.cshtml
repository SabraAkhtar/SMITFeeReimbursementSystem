@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.RefundListItemViewModel>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Refund Management";
    Layout = "_AdminLayout";
    var threshold = (decimal)ViewBag.EligibilityThreshold;
}

<partial name="_StatusMessage" />

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Refund Management</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">
            <i class="fa-solid fa-circle-info me-1" style="color:#3b82f6;"></i>
            Auto-eligibility threshold: <strong style="color:#2ecc71;">≥@threshold%</strong> attendance
        </p>
    </div>
    <a class="btn btn-success" asp-action="Eligible">
        <i class="fa-solid fa-star me-2"></i>Eligible Students
    </a>
</div>

<!-- Filter bar -->
<div class="filter-bar">
    <form method="get">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white" style="border-right:none;">
                        <i class="fa-solid fa-magnifying-glass text-muted fa-sm"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control" style="border-left:none;"
                           placeholder="Search student or course..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    @{
                        var st = ViewBag.Status as string ?? "";
                    }
                    @if (st == "") { <option value="" selected>All statuses</option> } else { <option value="">All statuses</option> }
                    @if (st == "Pending")  { <option value="Pending" selected>Pending</option>  } else { <option value="Pending">Pending</option>   }
                    @if (st == "Approved") { <option value="Approved" selected>Approved</option> } else { <option value="Approved">Approved</option> }
                    @if (st == "Rejected") { <option value="Rejected" selected>Rejected</option> } else { <option value="Rejected">Rejected</option> }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2 align-items-end" style="padding-top:0.5rem;">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="fa-solid fa-filter me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-xmark me-1"></i>Clear
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Table -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Attendance %</th>
                    <th class="text-center">Eligible</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div style="color:#94a3b8;">
                                <i class="fa-solid fa-hand-holding-dollar fa-2x mb-3 d-block" style="opacity:0.3;"></i>
                                <p class="mb-0">No refund records found.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var r in Model)
                {
                    var (badge, icon) = r.RefundStatus switch
                    {
                        RefundStatus.Approved => ("bg-success", "fa-circle-check"),
                        RefundStatus.Rejected => ("bg-danger",  "fa-circle-xmark"),
                        _                     => ("bg-warning text-dark", "fa-clock")
                    };
                    var attendPct = r.AttendancePercentage;
                    var attendColor = (decimal)attendPct >= threshold ? "#2ecc71" : "#ef4444";
                    <tr>
                        <td>
                            <div class="fw-600" style="font-weight:600;font-size:0.875rem;">@r.StudentName</div>
                        </td>
                        <td class="text-muted" style="font-size:0.875rem;">@r.CourseName</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:52px;height:6px;border-radius:3px;background:#f1f5f9;overflow:hidden;flex-shrink:0;">
                                    <div style="height:100%;width:@(Math.Min(100,attendPct))%;background:@attendColor;border-radius:3px;"></div>
                                </div>
                                <strong style="color:@attendColor;font-size:0.875rem;">@attendPct%</strong>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (r.IsEligible)
                            {
                                <span class="badge" style="background:rgba(46,204,113,0.1);color:#2ecc71;border:1px solid rgba(46,204,113,0.2);">
                                    <i class="fa-solid fa-check me-1"></i>Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background:rgba(239,68,68,0.08);color:#ef4444;border:1px solid rgba(239,68,68,0.15);">
                                    <i class="fa-solid fa-xmark me-1"></i>No
                                </span>
                            }
                        </td>
                        <td><span class="badge @badge"><i class="fa-solid @icon me-1"></i>@r.RefundStatus</span></td>
                        <td class="text-muted" style="font-size:0.8rem;">@r.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-id="@r.RefundId">
                                <i class="fa-solid fa-eye me-1"></i>Review
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
