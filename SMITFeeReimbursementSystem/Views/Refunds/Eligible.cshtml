@model IEnumerable<SMITFeeReimbursementSystem.Models.Refund>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Eligible Students";
    var threshold = (decimal)ViewBag.EligibilityThreshold;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 text-success mb-0">Eligible for Refund</h1>
        <p class="text-muted mb-0">Students with attendance ≥ @threshold%</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">All Refunds</a>
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search..." />
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th>Attendance %</th>
                    <th>Refund Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No eligible students yet. Mark attendance first.</td></tr>
            }
            @foreach (var r in Model)
            {
                var badge = r.RefundStatus switch
                {
                    RefundStatus.Approved => "bg-success",
                    RefundStatus.Rejected => "bg-danger",
                    _ => "bg-warning text-dark"
                };
                <tr>
                    <td>@(r.Student.FullName ?? "—")</td>
                    <td>@r.Student.Email</td>
                    <td>@r.Course.CourseName</td>
                    <td><span class="badge bg-success fs-6">@r.AttendancePercentage%</span></td>
                    <td><span class="badge @badge">@r.RefundStatus</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@r.RefundId">Review</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
