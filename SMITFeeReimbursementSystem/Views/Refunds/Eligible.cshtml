@model IEnumerable<SMITFeeReimbursementSystem.Models.Refund>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Eligible Students";
    Layout = "_AdminLayout";
    var threshold = (decimal)ViewBag.EligibilityThreshold;
}

<partial name="_StatusMessage" />

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Eligible for Refund</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">
            <i class="fa-solid fa-circle-check me-1" style="color:#2ecc71;"></i>
            Students with attendance ≥ <strong style="color:#2ecc71;">@threshold%</strong>
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>All Refunds
    </a>
</div>

<!-- Search -->
<div class="filter-bar mb-4">
    <form method="get">
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white" style="border-right:none;">
                        <i class="fa-solid fa-magnifying-glass text-muted fa-sm"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control" style="border-left:none;"
                           placeholder="Search student name or email..." />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2 align-items-end" style="padding-top:0.5rem;">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    <i class="fa-solid fa-filter me-1"></i>Search
                </button>
                <a asp-action="Eligible" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-xmark me-1"></i>Clear
                </a>
            </div>
        </div>
    </form>
</div>

<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th>Attendance %</th>
                    <th>Refund Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-5">
                        <div style="color:#94a3b8;">
                            <i class="fa-solid fa-star fa-2x mb-3 d-block" style="opacity:0.3;"></i>
                            <p class="mb-0">No eligible students yet. Mark attendance first.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var r in Model)
            {
                var badge = r.RefundStatus switch
                {
                    RefundStatus.Approved => "bg-success",
                    RefundStatus.Rejected => "bg-danger",
                    _ => "bg-warning text-dark"
                };
                <tr>
                    <td>
                        <div class="fw-600" style="font-weight:600;font-size:0.875rem;">@(r.Student.FullName ?? "—")</div>
                    </td>
                    <td class="text-muted" style="font-size:0.8rem;">@r.Student.Email</td>
                    <td class="text-muted" style="font-size:0.875rem;">@r.Course.CourseName</td>
                    <td>
                        <span class="badge bg-success" style="font-size:0.8rem;">
                            <i class="fa-solid fa-circle-check me-1"></i>@r.AttendancePercentage%
                        </span>
                    </td>
                    <td><span class="badge @badge">@r.RefundStatus</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-id="@r.RefundId">
                            <i class="fa-solid fa-eye me-1"></i>Review
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
