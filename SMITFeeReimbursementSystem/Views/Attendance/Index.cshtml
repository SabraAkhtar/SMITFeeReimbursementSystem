@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.AttendanceRecordViewModel>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Attendance Records";
    Layout = "_AdminLayout";
}

<partial name="_StatusMessage" />

<!-- SMIT LMS Portal Banner -->
<div class="card mb-4" style="border-radius:1rem;background:linear-gradient(135deg,#0f1923 0%,#1a2332 100%);border:1px solid rgba(46,204,113,0.25);overflow:hidden;">
    <div class="card-body p-3">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <div style="width:48px;height:48px;border-radius:12px;background:rgba(46,204,113,0.15);display:flex;align-items:center;justify-content:center;border:1px solid rgba(46,204,113,0.3);">
                    <i class="fa-solid fa-calendar-check fa-lg" style="color:#2ecc71;"></i>
                </div>
            </div>
            <div class="col">
                <div class="fw-bold text-white" style="font-size:0.92rem;">Official Attendance is tracked on SMIT Student Portal</div>
                <div style="color:rgba(255,255,255,0.5);font-size:0.78rem;">
                    This system records attendance internally. For official SMIT LMS attendance, visit the portal.
                </div>
            </div>
            <div class="col-auto">
                <a href="https://lms.saylanimit.com/login" target="_blank" rel="noopener"
                   class="btn btn-sm fw-bold"
                   style="background:#2ecc71;color:#fff;border:none;border-radius:0.5rem;padding:0.45rem 1rem;font-weight:600;box-shadow:0 4px 12px rgba(46,204,113,0.35);white-space:nowrap;">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open SMIT Portal
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Attendance Records</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">View and filter all student attendance entries</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Mark">
            <i class="fa-solid fa-pen-to-square me-2"></i>Mark Attendance
        </a>
        <a class="btn btn-outline-secondary" asp-action="MonthlyReport">
            <i class="fa-solid fa-file-chart-column me-2"></i>Monthly Report
        </a>
    </div>
</div>

<!-- Filters -->
<div class="filter-bar mb-4">
    <form method="get">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">Course</label>
                <select name="courseId" class="form-select" asp-items="ViewBag.CourseId">
                    <option value="">All courses</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Student</label>
                <select name="studentId" class="form-select" asp-items="ViewBag.StudentId">
                    <option value="">All students</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name..." />
            </div>
            <div class="col-12 d-flex gap-2 pt-1">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i>Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-xmark me-1"></i>Clear
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Table -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <div style="color:#94a3b8;">
                                <i class="fa-solid fa-calendar-check fa-2x mb-3 d-block" style="opacity:0.3;"></i>
                                <p class="mb-0">No attendance records found.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var r in Model)
                {
                    var (badge, icon) = r.Status switch
                    {
                        AttendanceStatus.Present => ("bg-success", "fa-circle-check"),
                        AttendanceStatus.Leave   => ("bg-info",    "fa-calendar-minus"),
                        _                        => ("bg-danger",  "fa-circle-xmark")
                    };
                    <tr>
                        <td>
                            <div class="fw-500" style="font-size:0.875rem;font-weight:500;">@r.Date.ToString("dd MMM yyyy")</div>
                            <div class="text-muted" style="font-size:0.75rem;">@r.Date.ToString("dddd")</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:30px;height:30px;border-radius:50%;background:rgba(46,204,113,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="fa-solid fa-user fa-xs" style="color:#2ecc71;"></i>
                                </div>
                                <span class="fw-500" style="font-weight:500;font-size:0.875rem;">@r.StudentName</span>
                            </div>
                        </td>
                        <td class="text-muted" style="font-size:0.875rem;">@r.CourseName</td>
                        <td>
                            <span class="badge @badge">
                                <i class="fa-solid @icon me-1"></i>@r.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
