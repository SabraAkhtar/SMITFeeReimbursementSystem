@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.AttendanceRecordViewModel>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Attendance Records";
}

<partial name="_StatusMessage" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 text-primary mb-0">Attendance Records</h1>
    <div>
        <a class="btn btn-primary" asp-action="Mark">Mark Attendance</a>
        <a class="btn btn-outline-primary" asp-action="MonthlyReport">Monthly Report</a>
    </div>
</div>

<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body row g-2">
        <div class="col-md-3">
            <label class="form-label">Course</label>
            <select name="courseId" class="form-select" asp-items="ViewBag.CourseId">
                <option value="">All courses</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Student</label>
            <select name="studentId" class="form-select" asp-items="ViewBag.StudentId">
                <option value="">All students</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name, course..." />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No attendance records found.</td></tr>
            }
            @foreach (var r in Model)
            {
                var badge = r.Status switch
                {
                    AttendanceStatus.Present => "bg-success",
                    AttendanceStatus.Leave => "bg-info text-dark",
                    _ => "bg-danger"
                };
                <tr>
                    <td>@r.Date.ToString("dd MMM yyyy")</td>
                    <td>@r.StudentName</td>
                    <td>@r.CourseName</td>
                    <td><span class="badge @badge">@r.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
