@model SMITFeeReimbursementSystem.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-user-circle text-primary fa-lg"></i>
                <span class="fw-semibold">My Profile</span>
                @if (!string.IsNullOrEmpty(Model.Role))
                {
                    <span class="badge bg-primary ms-auto">@Model.Role</span>
                }
            </div>
            <div class="card-body">
                <partial name="_StatusMessage" />
                <form asp-action="Index" method="post" data-loading="true">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input value="@Model.Email" class="form-control bg-light" disabled />
                        <div class="form-text">Email cannot be changed.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RollNumber" class="form-label fw-semibold"></label>
                        <input asp-for="RollNumber" class="form-control" placeholder="e.g. SMIT-2024-001" />
                        <span asp-validation-for="RollNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+92 300 0000000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-1"></i> Save Changes
                        </button>
                        <a asp-controller="Profile" asp-action="ChangePassword" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-lock me-1"></i> Change Password
                        </a>
                        <a asp-controller="Profile" asp-action="ChangeEmail" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-envelope me-1"></i> Change Email
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
