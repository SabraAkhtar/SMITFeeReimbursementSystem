@model SMITFeeReimbursementSystem.ViewModels.ChangeEmailViewModel
@{
    ViewData["Title"] = "Change Email";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="fa-solid fa-envelope me-2 text-primary"></i>Change Email
            </div>
            <div class="card-body">
                <partial name="_StatusMessage" />

                <div class="alert alert-info border-0 small mb-3">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Current email: <strong>@ViewBag.CurrentEmail</strong>
                </div>

                <form asp-action="ChangeEmail" method="post" data-loading="true">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 small"></div>

                    <div class="mb-4">
                        <label asp-for="NewEmail" class="form-label fw-semibold"></label>
                        <input asp-for="NewEmail" class="form-control"
                               placeholder="new@email.com" autocomplete="email" />
                        <span asp-validation-for="NewEmail" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-1"></i> Update Email
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
