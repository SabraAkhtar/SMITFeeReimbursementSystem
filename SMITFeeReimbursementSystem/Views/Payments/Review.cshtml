@model SMITFeeReimbursementSystem.ViewModels.PaymentReviewViewModel
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Review Payment";
    var isPending = Model.Status == PaymentStatus.Pending;
}

<partial name="_StatusMessage" />

<h1 class="h2 text-primary mb-4">Review Payment #@Model.Id</h1>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Student</dt><dd class="col-sm-8">@Model.StudentName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.StudentEmail</dd>
                    <dt class="col-sm-4">Course</dt><dd class="col-sm-8">@Model.CourseName</dd>
                    <dt class="col-sm-4">Amount</dt><dd class="col-sm-8">Rs. @Model.Amount.ToString("N0")</dd>
                    <dt class="col-sm-4">Transaction Id</dt><dd class="col-sm-8"><code>@Model.TransactionId</code></dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.Status == PaymentStatus.Approved ? "bg-success" : Model.Status == PaymentStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">
                            @Model.Status
                        </span>
                    </dd>
                    <dt class="col-sm-4">Submitted</dt><dd class="col-sm-8">@Model.SubmittedAt.ToLocalTime().ToString("f")</dd>
                    @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                    {
                        <dt class="col-sm-4">Remarks</dt><dd class="col-sm-8">@Model.AdminRemarks</dd>
                    }
                </dl>
            </div>
        </div>

        @if (isPending)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><strong>Admin action</strong></div>
                <div class="card-body">
                    <form asp-action="Approve" method="post" class="mb-3" data-loading="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label">Remarks (optional)</label>
                        <textarea name="adminRemarks" class="form-control mb-2" rows="2">@Model.AdminRemarks</textarea>
                        <button type="submit" class="btn btn-success">Approve &amp; Generate Receipt</button>
                    </form>
                    <form asp-action="Reject" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label">Rejection remarks</label>
                        <textarea name="adminRemarks" class="form-control mb-2" rows="2"></textarea>
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><strong>Payment Screenshot</strong></div>
            <div class="card-body text-center">
                <img src="@Model.ScreenshotPath" alt="Payment screenshot" class="img-fluid rounded border" style="max-height: 400px;" />
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to payments</a>
    @if (Model.Status == PaymentStatus.Approved)
    {
        <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-outline-success">View Receipt</a>
    }
</div>
