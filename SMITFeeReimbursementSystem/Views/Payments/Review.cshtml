@model SMITFeeReimbursementSystem.ViewModels.PaymentReviewViewModel
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Review Payment";
    Layout = "_AdminLayout";
    var isPending = Model.Status == PaymentStatus.Pending;
}

<partial name="_StatusMessage" />

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">
            Review Payment #@Model.Id
        </h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">Verify and approve or reject this fee payment</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Payments
        </a>
        @if (Model.Status == PaymentStatus.Approved)
        {
            <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-outline-success">
                <i class="fa-solid fa-receipt me-1"></i>View Receipt
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- Payment Info -->
        <div class="card admin-table-card mb-4">
            <div class="card-header" style="padding:1rem 1.25rem;">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-credit-card" style="color:#f59e0b;"></i>
                    <span style="font-weight:700;">Payment Information</span>
                </div>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Student</dt>
                    <dd class="col-sm-8 fw-600" style="font-weight:600;">@Model.StudentName</dd>

                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Email</dt>
                    <dd class="col-sm-8 text-muted">@Model.StudentEmail</dd>

                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Course</dt>
                    <dd class="col-sm-8">@Model.CourseName</dd>

                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Amount</dt>
                    <dd class="col-sm-8">
                        <span style="font-weight:700;color:#2ecc71;font-size:1.05rem;">Rs. @Model.Amount.ToString("N0")</span>
                    </dd>

                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Transaction ID</dt>
                    <dd class="col-sm-8"><code>@Model.TransactionId</code></dd>

                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var (bc, bi) = Model.Status switch
                            {
                                PaymentStatus.Approved => ("bg-success", "fa-circle-check"),
                                PaymentStatus.Rejected => ("bg-danger", "fa-circle-xmark"),
                                _ => ("bg-warning text-dark", "fa-clock")
                            };
                        }
                        <span class="badge @bc"><i class="fa-solid @bi me-1"></i>@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Submitted</dt>
                    <dd class="col-sm-8 text-muted" style="font-size:0.875rem;">@Model.SubmittedAt.ToLocalTime().ToString("f")</dd>

                    @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                    {
                        <dt class="col-sm-4 text-muted" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Remarks</dt>
                        <dd class="col-sm-8 text-muted">@Model.AdminRemarks</dd>
                    }
                </dl>
            </div>
        </div>

        @if (isPending)
        {
            <div class="card admin-table-card">
                <div class="card-header" style="padding:1rem 1.25rem;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gavel" style="color:#f59e0b;"></i>
                        <span style="font-weight:700;">Admin Action</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Approve" method="post" class="mb-4" data-loading="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label">Remarks (optional)</label>
                        <textarea name="adminRemarks" class="form-control mb-3" rows="2" placeholder="Add any notes...">@Model.AdminRemarks</textarea>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fa-solid fa-circle-check me-2"></i>Approve &amp; Generate Receipt
                        </button>
                    </form>
                    <hr style="border-color:#f1f5f9;" />
                    <form asp-action="Reject" method="post" data-loading="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label">Rejection Reason</label>
                        <textarea name="adminRemarks" class="form-control mb-3" rows="2" placeholder="Provide reason for rejection..."></textarea>
                        <button type="submit" class="btn btn-danger w-100"
                                data-confirm="Are you sure you want to reject this payment?">
                            <i class="fa-solid fa-circle-xmark me-2"></i>Reject Payment
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Screenshot -->
    <div class="col-lg-5">
        <div class="card admin-table-card">
            <div class="card-header" style="padding:1rem 1.25rem;">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-image" style="color:#3b82f6;"></i>
                    <span style="font-weight:700;">Payment Screenshot</span>
                </div>
            </div>
            <div class="card-body p-3 text-center">
                @if (!string.IsNullOrEmpty(Model.ScreenshotPath))
                {
                    <img src="@Model.ScreenshotPath" alt="Payment screenshot"
                         class="img-fluid rounded"
                         style="max-height: 420px;border:1.5px solid #e2e8f0;" />
                }
                else
                {
                    <div class="py-5" style="color:#94a3b8;">
                        <i class="fa-solid fa-image fa-3x mb-3 d-block" style="opacity:0.2;"></i>
                        <p class="mb-0">No screenshot uploaded.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
