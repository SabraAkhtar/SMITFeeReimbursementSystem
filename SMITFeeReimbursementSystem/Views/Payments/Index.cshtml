@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.PaymentListItemViewModel>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Payment Management";
    Layout = "_AdminLayout";
}

<partial name="_StatusMessage" />

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Payment Management</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">Review and manage all student fee payments</p>
    </div>
</div>

<!-- Filter partial -->
<partial name="_PaymentFilter" />

<!-- Table -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Amount</th>
                    <th>Transaction ID</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div style="color:#94a3b8;">
                                <i class="fa-solid fa-credit-card fa-2x mb-3 d-block" style="opacity:0.3;"></i>
                                <p class="mb-0">No payments found.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    var (badgeClass, badgeIcon) = p.Status switch
                    {
                        PaymentStatus.Approved => ("bg-success", "fa-circle-check"),
                        PaymentStatus.Rejected => ("bg-danger",  "fa-circle-xmark"),
                        _                      => ("bg-warning text-dark", "fa-clock")
                    };
                    <tr>
                        <td>
                            <div class="fw-600" style="font-weight:600;font-size:0.875rem;">@p.StudentName</div>
                        </td>
                        <td class="text-muted" style="font-size:0.875rem;">@p.CourseName</td>
                        <td>
                            <span class="fw-600" style="font-weight:600;color:#0f1923;">Rs. @p.Amount.ToString("N0")</span>
                        </td>
                        <td><code style="font-size:0.8rem;">@p.TransactionId</code></td>
                        <td>
                            <span class="badge @badgeClass">
                                <i class="fa-solid @badgeIcon me-1"></i>@p.Status
                            </span>
                        </td>
                        <td class="text-muted" style="font-size:0.8rem;">@p.SubmittedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Review" asp-route-id="@p.Id"
                                   title="Review">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                @if (p.ReceiptNumber is not null)
                                {
                                    <a class="btn btn-sm btn-outline-success"
                                       asp-action="Receipt" asp-route-id="@p.Id"
                                       title="View Receipt">
                                        <i class="fa-solid fa-receipt"></i>
                                    </a>
                                    <a class="btn btn-sm btn-success"
                                       asp-action="DownloadPdf" asp-route-id="@p.Id"
                                       title="Download PDF">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
