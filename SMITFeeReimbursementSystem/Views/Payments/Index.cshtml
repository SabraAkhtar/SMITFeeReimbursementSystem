@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.PaymentListItemViewModel>
@using SMITFeeReimbursementSystem.Models
@{
    ViewData["Title"] = "Payment Management";
}

<partial name="_StatusMessage" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 text-primary mb-0">Payment Management</h1>
</div>

<partial name="_PaymentFilter" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Amount</th>
                    <th>Transaction</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No payments found.</td></tr>
            }
            @foreach (var p in Model)
            {
                var badgeClass = p.Status switch
                {
                    PaymentStatus.Approved => "bg-success",
                    PaymentStatus.Rejected => "bg-danger",
                    _ => "bg-warning text-dark"
                };
                <tr>
                    <td>@p.StudentName</td>
                    <td>@p.CourseName</td>
                    <td>Rs. @p.Amount.ToString("N0")</td>
                    <td><code>@p.TransactionId</code></td>
                    <td><span class="badge @badgeClass">@p.Status</span></td>
                    <td>@p.SubmittedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-id="@p.Id"><i class="fa-solid fa-eye"></i></a>
                        @if (p.ReceiptNumber is not null)
                        {
                            <a class="btn btn-sm btn-outline-success" asp-action="Receipt" asp-route-id="@p.Id" title="View"><i class="fa-solid fa-receipt"></i></a>
                            <a class="btn btn-sm btn-success" asp-action="DownloadPdf" asp-route-id="@p.Id" title="PDF"><i class="fa-solid fa-file-pdf"></i></a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
