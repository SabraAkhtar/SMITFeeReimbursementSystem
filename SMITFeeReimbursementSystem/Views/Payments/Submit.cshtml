@model SMITFeeReimbursementSystem.ViewModels.PaymentSubmitViewModel
@{
    ViewData["Title"] = "Submit Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        @* Payment Account Numbers Card *@
        <div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #2ecc71 !important;">
            <div class="card-body p-3">
                <div class="fw-bold mb-2" style="color:#2ecc71;">
                    <i class="fa-solid fa-building-columns me-2"></i>Fee Payment Account Numbers
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                            <div class="small text-muted mb-1">
                                <i class="fa-solid fa-mobile-screen me-1"></i>EasyPaisa Account
                            </div>
                            <div class="fw-bold fs-5" style="color:#2ecc71; letter-spacing:0.05em;">
                                0300-1234567
                            </div>
                            <div class="small text-muted">Account Title: SMIT Fee Account</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                            <div class="small text-muted mb-1">
                                <i class="fa-solid fa-landmark me-1"></i>Meezan Bank Account
                            </div>
                            <div class="fw-bold fs-5" style="color:#2ecc71; letter-spacing:0.05em;">
                                0123-4567890-001
                            </div>
                            <div class="small text-muted">Account Title: SMIT Fee Account</div>
                        </div>
                    </div>
                </div>
                <div class="alert alert-warning border-0 mt-3 mb-0 small py-2">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <strong>Note:</strong> Inhi numbers par payment karen. Transaction ID save karen aur screenshot upload karen.
                </div>
            </div>
        </div>

        <form asp-action="Submit" method="post" enctype="multipart/form-data"
              class="card border-0 shadow-sm" data-loading="true">
            <div class="card-header bg-white fw-semibold border-0 pt-3">
                <i class="fa-solid fa-upload me-2 text-primary"></i>Submit Fee Payment
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label fw-semibold">Select Course</label>
                    <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId" id="courseSelect">
                        <option value="">-- Select a course --</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label fw-semibold">Fee Amount (PKR)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">Rs.</span>
                        <input asp-for="Amount" class="form-control" id="amountInput" readonly />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                    <div class="form-text">Fee is fixed at Rs. 3,000 per course.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="TransactionId" class="form-label fw-semibold">Transaction ID</label>
                    <input asp-for="TransactionId" class="form-control"
                           placeholder="e.g. TXN123456789" />
                    <span asp-validation-for="TransactionId" class="text-danger small"></span>
                    <div class="form-text">Enter the transaction ID from your JazzCash / EasyPaisa receipt.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Screenshot" class="form-label fw-semibold">Payment Screenshot</label>
                    <input asp-for="Screenshot" type="file" class="form-control"
                           accept="image/*" id="screenshotInput" />
                    <span asp-validation-for="Screenshot" class="text-danger small"></span>
                    <div class="form-text">Upload a clear screenshot of your payment confirmation.</div>
                    <img id="screenshotPreview" src="#" alt="Preview"
                         class="img-fluid rounded border mt-2 d-none" style="max-height:200px;" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Payment
                    </button>
                    <a asp-action="MyPayments" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-list me-1"></i> My Payments
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-set amount to 3000 when course selected
        document.getElementById('courseSelect').addEventListener('change', function () {
            const amountInput = document.getElementById('amountInput');
            if (this.value) {
                amountInput.value = '3000';
            } else {
                amountInput.value = '';
            }
        });

        // Screenshot preview
        document.getElementById('screenshotInput').addEventListener('change', function () {
            const preview = document.getElementById('screenshotPreview');
            const file = this.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                preview.classList.add('d-none');
            }
        });

        // Set initial amount if course already selected (on validation fail)
        window.addEventListener('DOMContentLoaded', function () {
            const sel = document.getElementById('courseSelect');
            const amt = document.getElementById('amountInput');
            if (sel.value && !amt.value) amt.value = '3000';
        });
    </script>
}
