@model SMITFeeReimbursementSystem.ViewModels.PaymentSubmitViewModel
@{
    ViewData["Title"] = "Submit Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">

        <!-- Page title -->
        <div class="mb-4">
            <h2 class="mb-1" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Submit Fee Payment</h2>
            <p class="text-muted mb-0" style="font-size:0.875rem;">Complete your fee submission to proceed with enrollment</p>
        </div>

        @* Payment Account Info Card *@
        <div class="card border-0 mb-4"
             style="border-radius:1rem;overflow:hidden;box-shadow:0 4px 20px rgba(46,204,113,0.12);">
            <div class="p-3"
                 style="background:linear-gradient(135deg,#0f1923,#1a2332);border-bottom:2px solid #2ecc71;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:34px;height:34px;border-radius:8px;background:rgba(46,204,113,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fa-solid fa-building-columns" style="color:#2ecc71;font-size:0.9rem;"></i>
                    </div>
                    <span class="fw-700" style="font-weight:700;color:#2ecc71;font-size:0.95rem;">Fee Payment Account Numbers</span>
                </div>
            </div>
            <div class="card-body p-3" style="background:#f8fffe;">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3" style="background:#fff;border:1.5px solid rgba(46,204,113,0.2);">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-mobile-screen fa-sm" style="color:#2ecc71;"></i>
                                <span class="text-muted" style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;">EasyPaisa</span>
                            </div>
                            <div class="fw-700" style="font-weight:700;font-size:1.1rem;color:#2ecc71;letter-spacing:0.04em;">0300-1234567</div>
                            <div class="text-muted" style="font-size:0.78rem;">SMIT Fee Account</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3" style="background:#fff;border:1.5px solid rgba(46,204,113,0.2);">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-landmark fa-sm" style="color:#2ecc71;"></i>
                                <span class="text-muted" style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;">Meezan Bank</span>
                            </div>
                            <div class="fw-700" style="font-weight:700;font-size:1.1rem;color:#2ecc71;letter-spacing:0.04em;">0123-4567890-001</div>
                            <div class="text-muted" style="font-size:0.78rem;">SMIT Fee Account</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-2 p-2 rounded-2"
                     style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);">
                    <i class="fa-solid fa-triangle-exclamation text-warning mt-1 flex-shrink-0"></i>
                    <div style="font-size:0.8rem;color:#92400e;">
                        <strong>Important:</strong> Pay to these accounts only. Save the transaction ID and upload a clear payment screenshot.
                    </div>
                </div>
            </div>
        </div>

        @* Submit Form *@
        <div class="card border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.07);">
            <div class="card-header" style="border-radius:1rem 1rem 0 0;background:#fff;border-bottom:1px solid #f1f5f9;padding:1.1rem 1.5rem;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(46,204,113,0.1);display:flex;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-upload" style="color:#2ecc71;font-size:0.85rem;"></i>
                    </div>
                    <span class="fw-700" style="font-weight:700;">Payment Details</span>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Submit" method="post" enctype="multipart/form-data" data-loading="true">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="CourseId" class="form-label">Select Course</label>
                        <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId" id="courseSelect">
                            <option value="">— Choose a course —</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label">Fee Amount (PKR)</label>
                        <div class="input-group">
                            <span class="input-group-text fw-600" style="font-weight:600;background:#f8fafc;border:1.5px solid #e2e8f0;border-right:none;color:#2ecc71;">Rs.</span>
                            <input asp-for="Amount" class="form-control" id="amountInput" readonly
                                   style="border-left:none;background:#f8fafc;font-weight:600;font-size:1rem;" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger d-block mt-1"></span>
                        <div class="form-text">Fee is fixed at <strong>Rs. 3,000</strong> per course.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TransactionId" class="form-label">Transaction ID</label>
                        <div class="input-group">
                            <span class="input-group-text" style="background:#f8fafc;border:1.5px solid #e2e8f0;border-right:none;">
                                <i class="fa-solid fa-hashtag text-muted fa-sm"></i>
                            </span>
                            <input asp-for="TransactionId" class="form-control"
                                   style="border-left:none;"
                                   placeholder="e.g. TXN123456789" />
                        </div>
                        <span asp-validation-for="TransactionId" class="text-danger d-block mt-1"></span>
                        <div class="form-text">Enter the transaction ID from your JazzCash / EasyPaisa receipt.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Screenshot" class="form-label">Payment Screenshot</label>
                        <div class="upload-area" id="uploadArea"
                             style="border:2px dashed #d1d5db;border-radius:0.75rem;padding:1.5rem;text-align:center;cursor:pointer;transition:all 0.2s;background:#fafafa;">
                            <i class="fa-solid fa-cloud-arrow-up fa-2x mb-2 d-block" style="color:#94a3b8;"></i>
                            <div style="font-size:0.875rem;color:#64748b;font-weight:500;">Click to upload screenshot</div>
                            <div style="font-size:0.75rem;color:#94a3b8;margin-top:0.25rem;">PNG, JPG, JPEG up to 5MB</div>
                        </div>
                        <input asp-for="Screenshot" type="file" class="form-control mt-2"
                               accept="image/*" id="screenshotInput" />
                        <span asp-validation-for="Screenshot" class="text-danger d-block mt-1"></span>
                        <img id="screenshotPreview" src="#" alt="Preview"
                             class="img-fluid rounded mt-3 d-none"
                             style="max-height:180px;border:1.5px solid #e2e8f0;" />
                    </div>

                    <div class="d-flex gap-3 pt-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fa-solid fa-paper-plane me-2"></i>Submit Payment
                        </button>
                        <a asp-action="MyPayments" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-list me-1"></i>My Payments
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-set amount to 3000 when course selected
        document.getElementById('courseSelect').addEventListener('change', function () {
            const amountInput = document.getElementById('amountInput');
            if (this.value) {
                amountInput.value = '3000';
            } else {
                amountInput.value = '';
            }
        });

        // Screenshot preview + upload area feedback
        const screenshotInput = document.getElementById('screenshotInput');
        const uploadArea       = document.getElementById('uploadArea');

        uploadArea.addEventListener('click', () => screenshotInput.click());
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = '#2ecc71';
            uploadArea.style.background  = 'rgba(46,204,113,0.04)';
        });
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.style.borderColor = '#d1d5db';
            uploadArea.style.background  = '#fafafa';
        });
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            if (e.dataTransfer.files.length) {
                const dt = new DataTransfer();
                dt.items.add(e.dataTransfer.files[0]);
                screenshotInput.files = dt.files;
                screenshotInput.dispatchEvent(new Event('change'));
            }
            uploadArea.style.borderColor = '#d1d5db';
            uploadArea.style.background  = '#fafafa';
        });

        screenshotInput.addEventListener('change', function () {
            const preview = document.getElementById('screenshotPreview');
            const file = this.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    uploadArea.innerHTML = '<i class="fa-solid fa-circle-check fa-2x mb-2 d-block" style="color:#2ecc71;"></i><div style="font-size:0.875rem;color:#2ecc71;font-weight:600;">' + file.name + '</div>';
                    uploadArea.style.borderColor = '#2ecc71';
                    uploadArea.style.background  = 'rgba(46,204,113,0.03)';
                };
                reader.readAsDataURL(file);
            } else {
                preview.classList.add('d-none');
            }
        });

        // Set initial amount if course already selected (on validation fail)
        window.addEventListener('DOMContentLoaded', function () {
            const sel = document.getElementById('courseSelect');
            const amt = document.getElementById('amountInput');
            if (sel.value && !amt.value) amt.value = '3000';
        });
    </script>
}
