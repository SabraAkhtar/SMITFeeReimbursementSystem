@model SMITFeeReimbursementSystem.Models.Receipt
@{
    ViewData["Title"] = "Payment Receipt";
}

<partial name="_StatusMessage" />

<div id="receiptPrintArea" class="receipt-document card border-0 shadow-sm mx-auto">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="receipt-logo mb-2"><i class="fa-solid fa-graduation-cap fa-2x text-primary"></i></div>
            <h2 class="text-primary mb-1 fw-bold">SMIT Fee Reimbursement</h2>
            <p class="text-muted mb-0">Official Payment Receipt</p>
        </div>
        <hr class="my-4" />
        <div class="row g-3">
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Receipt Number</span>
                    <span class="receipt-value fw-bold text-primary">@Model.ReceiptNumber</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Generated On</span>
                    <span class="receipt-value">@Model.GeneratedAt.ToLocalTime().ToString("f")</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Student Name</span>
                    <span class="receipt-value">@Model.StudentName</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Roll Number</span>
                    <span class="receipt-value">@(string.IsNullOrWhiteSpace(Model.RollNumber) ? "—" : Model.RollNumber)</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Course</span>
                    <span class="receipt-value">@Model.CourseName</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Amount Paid</span>
                    <span class="receipt-value fs-5 fw-bold text-success">Rs. @Model.Amount.ToString("N0")</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Transaction ID</span>
                    <span class="receipt-value"><code>@Model.TransactionId</code></span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="receipt-field">
                    <span class="receipt-label">Payment Date</span>
                    <span class="receipt-value">@Model.PaymentDate.ToLocalTime().ToString("dd MMMM yyyy")</span>
                </div>
            </div>
            <div class="col-12">
                <div class="receipt-field">
                    <span class="receipt-label">Approved By</span>
                    <span class="receipt-value">@Model.ApprovedByName</span>
                </div>
            </div>
        </div>
        <div class="alert alert-success mt-4 mb-0 small">
            <i class="fa-solid fa-circle-check me-1"></i>
            This receipt confirms that the payment has been verified and approved by the administration.
        </div>
    </div>
</div>

<div class="text-center mt-4 no-print d-flex flex-wrap gap-2 justify-content-center">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Payments</a>
    }
    else
    {
        <a asp-action="MyPayments" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> My Payments</a>
    }
    <a asp-action="DownloadPdf" asp-route-id="@Model.PaymentId" class="btn btn-primary">
        <i class="fa-solid fa-file-pdf me-1"></i> Download PDF
    </a>
    <button type="button" onclick="window.print()" class="btn btn-outline-primary">
        <i class="fa-solid fa-print me-1"></i> Print Receipt
    </button>
</div>

@section Scripts {
<style>
    .receipt-field { display: flex; flex-direction: column; }
    .receipt-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; }
    .receipt-value { font-size: 1rem; color: #1e293b; }
    @@media print {
        .no-print, header, footer, nav, .navbar { display: none !important; }
        .receipt-document { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
        body { background: #fff !important; }
        .container { max-width: 100% !important; }
    }
</style>
}
