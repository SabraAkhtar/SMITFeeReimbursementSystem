@model SMITFeeReimbursementSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    var isFirstUser = ViewBag.IsFirstUser as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <div class="auth-logo mx-auto mb-3">
                <i class="fa-solid fa-user-plus fa-xl text-primary"></i>
            </div>
            <h3 class="fw-bold mb-1">Create Account</h3>
            <p class="text-muted small">Join SMIT Fee Reimbursement System</p>
        </div>

        @if (isFirstUser)
        {
            <div class="alert alert-info border-0 small">
                <i class="fa-solid fa-crown me-2 text-warning"></i>
                You are the first user — you'll automatically receive the <strong>Admin</strong> role.
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Register" method="post" data-loading="true">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-user text-muted small"></i>
                            </span>
                            <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Your full name" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RollNumber" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-id-card text-muted small"></i>
                            </span>
                            <input asp-for="RollNumber" class="form-control border-start-0 ps-0" placeholder="e.g. SMIT-2024-001" />
                        </div>
                        <span asp-validation-for="RollNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-envelope text-muted small"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0"
                                   autocomplete="username" placeholder="your@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-lock text-muted small"></i>
                            </span>
                            <input asp-for="Password" class="form-control border-start-0 ps-0"
                                   autocomplete="new-password" placeholder="Min. 6 characters" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-lock text-muted small"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0"
                                   autocomplete="new-password" placeholder="Repeat password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    @if (!isFirstUser)
                    {
                        <div class="mb-4">
                            <label asp-for="Role" class="form-label fw-semibold small"></label>
                            <select asp-for="Role" class="form-select"
                                    asp-items="@(new SelectList(SMITFeeReimbursementSystem.Models.AppRoles.Registerable))">
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="fa-solid fa-user-plus me-2"></i>Create Account
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center mt-3 small text-muted">
            Already have an account?
            <a asp-action="Login" class="fw-semibold">Sign in</a>
        </p>
    </div>
</div>

<style>
.auth-logo {
    width: 64px; height: 64px;
    background: #e0e7ff;
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
