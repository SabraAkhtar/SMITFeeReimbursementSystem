@{
    ViewData["Title"] = "Reset Link Generated";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body p-5">
                <i class="fa-solid fa-envelope-circle-check fa-3x text-success mb-3"></i>
                <h4 class="mb-2">Reset Link Ready</h4>
                <p class="text-muted mb-4">
                    In a production system, this link would be emailed to you.<br />
                    For this demo, use the link below:
                </p>
                @if (TempData["ResetLink"] is string link)
                {
                    <div class="alert alert-info text-start small text-break">
                        <strong>Demo Reset Link:</strong><br />
                        <a href="@link">@link</a>
                    </div>
                }
                <a asp-action="Login" class="btn btn-primary">Back to Login</a>
            </div>
        </div>
    </div>
</div>
