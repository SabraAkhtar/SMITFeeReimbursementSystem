@model SMITFeeReimbursementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<style>
.auth-wrap {
    min-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
}
.auth-card {
    width: 100%;
    max-width: 420px;
}
.auth-logo-wrap {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #0f1923 0%, #1a2332 100%);
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.25rem;
    box-shadow: 0 6px 20px rgba(15,25,35,0.25);
}
.auth-logo-wrap i { font-size: 1.75rem; color: #2ecc71; }
.auth-divider {
    display: flex; align-items: center; gap: 0.75rem;
    color: #94a3b8; font-size: 0.8rem; margin: 1.25rem 0;
}
.auth-divider::before, .auth-divider::after {
    content: ''; flex: 1; height: 1px; background: #e2e8f0;
}
.auth-input-group .input-group-text {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-right: none;
    color: #94a3b8;
    border-radius: 0.5rem 0 0 0.5rem;
}
.auth-input-group .form-control {
    border: 1.5px solid #e2e8f0;
    border-left: none;
    border-radius: 0 0.5rem 0.5rem 0;
    padding-left: 0.5rem;
}
.auth-input-group .form-control:focus {
    border-color: #2ecc71;
    box-shadow: 0 0 0 3px rgba(46,204,113,0.12);
    z-index: 2;
}
.auth-input-group .form-control:focus + .input-group-text,
.auth-input-group .input-group-text:has(+ .form-control:focus) {
    border-color: #2ecc71;
}
.auth-submit-btn {
    background: linear-gradient(135deg, #2ecc71, #27ae60);
    border: none;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem;
    border-radius: 0.6rem;
    letter-spacing: 0.01em;
    box-shadow: 0 4px 14px rgba(46,204,113,0.35);
    transition: all 0.2s;
    width: 100%;
}
.auth-submit-btn:hover {
    background: linear-gradient(135deg, #33d973, #2ecc71);
    box-shadow: 0 6px 20px rgba(46,204,113,0.45);
    transform: translateY(-1px);
    color: #fff;
}
.brand-tag {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: rgba(46,204,113,0.08);
    border: 1px solid rgba(46,204,113,0.2);
    border-radius: 2rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #27ae60;
    margin-bottom: 0.75rem;
}
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="auth-logo-wrap">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="brand-tag">
                <i class="fa-solid fa-shield-halved fa-xs"></i> Secure Login
            </div>
            <h2 class="fw-800 mb-1" style="font-weight:800;font-size:1.5rem;letter-spacing:-0.03em;">Welcome back</h2>
            <p class="text-muted mb-0" style="font-size:0.875rem;">Sign in to your SMIT account</p>
        </div>

        <div class="card border-0 shadow" style="border-radius:1rem;">
            <div class="card-body p-4">
                <partial name="_StatusMessage" />
                <form asp-action="Login" method="post" data-loading="true">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group auth-input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-envelope fa-sm"></i>
                            </span>
                            <input asp-for="Email" class="form-control"
                                   autocomplete="username" placeholder="your@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label mb-0"></label>
                            <a asp-action="ForgotPassword" class="small" style="color:#2ecc71;">Forgot password?</a>
                        </div>
                        <div class="input-group auth-input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-lock fa-sm"></i>
                            </span>
                            <input asp-for="Password" class="form-control"
                                   autocomplete="current-password" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger d-block mt-1"></span>
                    </div>

                    <div class="mb-4 d-flex align-items-center gap-2">
                        <input asp-for="RememberMe" class="form-check-input mt-0" style="cursor:pointer;" />
                        <label asp-for="RememberMe" class="form-check-label" style="font-size:0.875rem;cursor:pointer;color:#475569;"></label>
                    </div>

                    <button type="submit" class="auth-submit-btn">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                    </button>
                </form>

                <div class="auth-divider">or</div>

                <div class="text-center">
                    <p class="text-muted mb-0" style="font-size:0.875rem;">
                        Don't have an account?
                        <a asp-action="Register" style="color:#2ecc71;font-weight:600;">Create one free</a>
                    </p>
                </div>
            </div>
        </div>

        <p class="text-center mt-3 text-muted" style="font-size:0.75rem;">
            <i class="fa-solid fa-lock fa-xs me-1"></i>
            Your data is protected with enterprise-grade security
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
