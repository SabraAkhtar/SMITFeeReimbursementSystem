@model IEnumerable<SMITFeeReimbursementSystem.ViewModels.StudentListItemViewModel>
@{
    ViewData["Title"] = "Students";
    Layout = "_AdminLayout";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages ?? 1);
    var totalCount  = (int)(ViewBag.TotalCount ?? 0);
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-0" style="font-weight:800;font-size:1.25rem;letter-spacing:-0.02em;color:#0f1923;">Students</h2>
        <p class="text-muted mb-0" style="font-size:0.875rem;">
            <i class="fa-solid fa-users me-1"></i>@totalCount registered student(s)
        </p>
    </div>
</div>

<!-- Search bar -->
<div class="filter-bar">
    <form method="get">
        <div class="row g-2 align-items-center">
            <div class="col-md-8 col-lg-9">
                <div class="input-group">
                    <span class="input-group-text bg-white" style="border-right:none;">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control"
                           style="border-left:none;"
                           placeholder="Search by name, email or roll number..." />
                </div>
            </div>
            <div class="col-md-4 col-lg-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    <i class="fa-solid fa-search me-1"></i>Search
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                }
            </div>
        </div>
    </form>
</div>

<!-- Table -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:50px;">#</th>
                    <th>Student</th>
                    <th>Roll No.</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-center">Courses</th>
                    <th class="text-end" style="width:150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div style="color:#94a3b8;">
                                <i class="fa-solid fa-users fa-2x mb-3 d-block" style="opacity:0.3;"></i>
                                <p class="mb-2 fw-500">No students found</p>
                                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear search</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @{ int rowNum = (currentPage - 1) * 10 + 1; }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-muted" style="font-size:0.8rem;">@rowNum</td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,rgba(46,204,113,0.15),rgba(46,204,113,0.05));display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid rgba(46,204,113,0.2);">
                                    <i class="fa-solid fa-user" style="color:#2ecc71;font-size:0.8rem;"></i>
                                </div>
                                <div>
                                    <div class="fw-600" style="font-weight:600;font-size:0.9rem;">@s.FullName</div>
                                </div>
                            </div>
                        </td>
                        <td><code style="font-size:0.8rem;">@s.RollNumber</code></td>
                        <td class="text-muted" style="font-size:0.875rem;">@s.Email</td>
                        <td class="text-muted" style="font-size:0.875rem;">@(s.Phone ?? "—")</td>
                        <td class="text-center">
                            <span class="badge" style="background:rgba(46,204,113,0.12);color:#2ecc71;border:1px solid rgba(46,204,113,0.2);font-size:0.8rem;">
                                @s.EnrolledCourses
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-secondary" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <p class="text-muted mb-0" style="font-size:0.82rem;">
            Page @currentPage of @totalPages — @totalCount total students
        </p>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search">
                        <i class="fa-solid fa-chevron-left fa-xs"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search">
                        <i class="fa-solid fa-chevron-right fa-xs"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
