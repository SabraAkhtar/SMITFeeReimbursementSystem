@model SMITFeeReimbursementSystem.ViewModels.StudentListItemViewModel
@{
    ViewData["Title"] = "Delete Student";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm border-danger border-top border-4">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-triangle-exclamation fa-3x text-danger mb-3"></i>
                <h4 class="mb-2">Delete Student?</h4>
                <p class="text-muted mb-4">
                    You are about to permanently delete <strong>@Model.FullName</strong>.<br />
                    This action cannot be undone.
                </p>
                <div class="bg-light rounded p-3 text-start mb-4">
                    <div class="row g-2 small">
                        <div class="col-5 text-muted">Name</div><div class="col-7 fw-semibold">@Model.FullName</div>
                        <div class="col-5 text-muted">Roll No.</div><div class="col-7">@Model.RollNumber</div>
                        <div class="col-5 text-muted">Email</div><div class="col-7">@Model.Email</div>
                    </div>
                </div>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-loading="true">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-1"></i> Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
