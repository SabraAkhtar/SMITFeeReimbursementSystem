@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SMIT Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body>
    <partial name="_LoadingOverlay" />
    <div class="admin-sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="admin-wrapper">
        <!-- ===== SIDEBAR ===== -->
        <aside class="admin-sidebar" id="adminSidebar">
            <a class="admin-sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <i class="fa-solid fa-graduation-cap"></i>
                <span class="admin-sidebar-brand-text">
                    <span>SMIT Admin</span>
                    <small>Fee Reimbursement</small>
                </span>
            </a>

            <nav class="nav flex-column py-1 flex-grow-1">
                <span class="sidebar-section-label">Main</span>

                <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="fa-solid fa-gauge-high fa-fw"></i>
                    <span>Dashboard</span>
                </a>

                <a class="nav-link @(controller == "Students" ? "active" : "")"
                   asp-controller="Students" asp-action="Index">
                    <i class="fa-solid fa-user-graduate fa-fw"></i>
                    <span>Students</span>
                </a>

                <a class="nav-link @(controller == "Courses" ? "active" : "")"
                   asp-controller="Courses" asp-action="Index">
                    <i class="fa-solid fa-book-open fa-fw"></i>
                    <span>Courses</span>
                </a>

                <span class="sidebar-section-label">Finance</span>

                <a class="nav-link @(controller == "Payments" ? "active" : "")"
                   asp-controller="Payments" asp-action="Index">
                    <i class="fa-solid fa-credit-card fa-fw"></i>
                    <span>Payments</span>
                </a>

                <a class="nav-link @(controller == "Refunds" ? "active" : "")"
                   asp-controller="Refunds" asp-action="Index">
                    <i class="fa-solid fa-hand-holding-dollar fa-fw"></i>
                    <span>Refunds</span>
                </a>

                <span class="sidebar-section-label">Academic</span>

                <a class="nav-link @(controller == "Attendance" ? "active" : "")"
                   asp-controller="Attendance" asp-action="Index">
                    <i class="fa-solid fa-calendar-check fa-fw"></i>
                    <span>Attendance</span>
                </a>

                <hr />

                <a class="nav-link @(controller == "Profile" ? "active" : "")"
                   asp-controller="Profile" asp-action="Index">
                    <i class="fa-solid fa-user-circle fa-fw"></i>
                    <span>My Profile</span>
                </a>

                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house fa-fw"></i>
                    <span>Public Site</span>
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:6px;height:6px;border-radius:50%;background:#2ecc71;"></div>
                    <span>System Online</span>
                </div>
            </div>
        </aside>

        <!-- ===== MAIN ===== -->
        <div class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <button type="button"
                            class="admin-sidebar-toggle"
                            id="sidebarToggle"
                            aria-label="Toggle sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="admin-topbar-title">@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="admin-topbar-right">
                    <span class="d-none d-md-flex align-items-center gap-2 topbar-user">
                        <div class="topbar-avatar">
                            <i class="fa-solid fa-user-shield fa-xs"></i>
                        </div>
                        <span>@(ViewBag.AdminName ?? "Administrator")</span>
                    </span>
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <!-- Content -->
            <div class="admin-content">
                <partial name="_StatusMessage" />
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
    (function () {
        const sidebar  = document.getElementById('adminSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggle   = document.getElementById('sidebarToggle');
        if (!sidebar || !toggle) return;

        function openSidebar() {
            sidebar.classList.add('show');
            backdrop.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeSidebar() {
            sidebar.classList.remove('show');
            backdrop.classList.remove('show');
            document.body.style.overflow = '';
        }

        toggle.addEventListener('click', function () {
            sidebar.classList.contains('show') ? closeSidebar() : openSidebar();
        });
        backdrop.addEventListener('click', closeSidebar);

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeSidebar();
        });
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
