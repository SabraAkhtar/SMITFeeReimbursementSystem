@using SMITFeeReimbursementSystem.Models
@using SMITFeeReimbursementSystem.Services
@model List<Notification>

@{
    int unread = ViewBag.UnreadCount ?? 0;
    NotificationSummary summary = ViewBag.Summary;
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<li class="nav-item dropdown ms-2" id="notif-bell-wrapper">
    <a class="nav-link position-relative px-2" href="#" role="button"
       id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false"
       title="Notifications">
        <i class="fa-solid fa-bell fs-5"></i>
        @if (unread > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="font-size:0.65rem;min-width:18px;" id="notif-badge">
                @(unread > 99 ? "99+" : unread.ToString())
            </span>
        }
    </a>

    <div class="dropdown-menu dropdown-menu-end shadow-lg p-0"
         style="width:360px;max-height:500px;overflow:hidden;border-radius:12px;"
         aria-labelledby="notifDropdown">

        @* Header *@
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom"
             style="background:#f8fafc;">
            <span class="fw-bold text-dark" style="font-weight:600;font-size:0.9rem;">
                <i class="fa-solid fa-bell me-2 text-primary"></i>Notifications
            </span>
            @if (unread > 0)
            {
                <button class="btn btn-sm btn-link text-muted p-0 text-decoration-none"
                        id="markAllReadBtn" style="font-size:0.8rem;">
                    <i class="fa-solid fa-check-double me-1"></i>Mark all read
                </button>
            }
        </div>

        @* Admin-only: Payment summary pills *@
        @if (isAdmin)
        {
            <div class="d-flex gap-2 px-3 py-2 border-bottom flex-wrap" style="background:#f8fafc;">
                <span class="badge bg-warning text-dark">
                    <i class="fa-solid fa-clock me-1"></i>Pending: @summary.Pending
                </span>
                <span class="badge bg-success">
                    <i class="fa-solid fa-circle-check me-1"></i>Approved: @summary.Approved
                </span>
                <span class="badge bg-danger">
                    <i class="fa-solid fa-circle-xmark me-1"></i>Rejected: @summary.Rejected
                </span>
            </div>
        }

        @* Notification list *@
        <ul class="list-unstyled mb-0" style="max-height:310px;overflow-y:auto;">
            @if (!Model.Any())
            {
                <li class="text-center text-muted py-4">
                    <i class="fa-solid fa-bell-slash fa-2x mb-2 d-block" style="opacity:0.3;"></i>
                    <span style="font-size:0.85rem;">No notifications yet</span>
                </li>
            }
            else
            {
                foreach (var n in Model)
                {
                    var bgClass = n.IsRead ? "" : "bg-primary bg-opacity-10";
                    var actionUrl = n.ActionUrl ?? (isAdmin ? "/Payments" : "/Payments/MyPayments");
                    <li>
                        <a href="/Notifications/Open/@n.Id?returnUrl=@Uri.EscapeDataString(actionUrl)"
                           class="d-flex align-items-start gap-2 px-3 py-2 text-decoration-none text-dark border-bottom notif-item @bgClass"
                           style="transition:background 0.15s;">
                            <span class="mt-1 flex-shrink-0">
                                @if (n.Type == NotificationType.PaymentSubmitted)
                                {
                                    <i class="fa-solid fa-file-invoice-dollar text-primary"></i>
                                }
                                else if (n.Type == NotificationType.PaymentApproved)
                                {
                                    <i class="fa-solid fa-circle-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-xmark text-danger"></i>
                                }
                            </span>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-semibold small text-truncate">@n.Title</div>
                                <div class="text-muted" style="font-size:0.78rem;white-space:normal;line-height:1.3;">@n.Message</div>
                                <div class="text-muted mt-1" style="font-size:0.72rem;">
                                    <i class="fa-regular fa-clock me-1"></i>@n.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
                                </div>
                            </div>
                            @if (!n.IsRead)
                            {
                                <span class="mt-2 flex-shrink-0">
                                    <span class="rounded-circle bg-primary d-inline-block"
                                          style="width:8px;height:8px;"></span>
                                </span>
                            }
                        </a>
                    </li>
                }
            }
        </ul>

        @* Footer *@
        <div class="text-center border-top py-2" style="background:#f8fafc;">
            @if (isAdmin)
            {
                <a asp-controller="Payments" asp-action="Index"
                   class="small text-primary text-decoration-none fw-semibold">
                    View all payments <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <a asp-controller="Payments" asp-action="MyPayments"
                   class="small text-primary text-decoration-none fw-semibold">
                    View my payments <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            }
        </div>
    </div>
</li>

@Html.AntiForgeryToken()

<script>
    (function () {
        var btn = document.getElementById('markAllReadBtn');
        if (!btn) return;
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var token = document.querySelector('[name=__RequestVerificationToken]');
            fetch('/Notifications/MarkAllRead', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token ? token.value : '' }
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (data.success) {
                    var badge = document.getElementById('notif-badge');
                    if (badge) badge.remove();
                    document.querySelectorAll('.notif-item').forEach(function (el) {
                        el.classList.remove('bg-primary', 'bg-opacity-10');
                    });
                    document.querySelectorAll('.rounded-circle.bg-primary').forEach(function (el) {
                        el.remove();
                    });
                    btn.remove();
                }
            });
        });
    })();
</script>
