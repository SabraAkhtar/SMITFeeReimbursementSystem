@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using SMITFeeReimbursementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="#"
           role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-circle-user"></i>
            <span class="d-none d-md-inline small">@User.Identity?.Name</span>
            @if (role is not null)
            {
                <span class="badge bg-white text-primary small">@role</span>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
            <li>
                <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                    <i class="fa-solid fa-user me-2 text-muted"></i>My Profile
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword">
                    <i class="fa-solid fa-lock me-2 text-muted"></i>Change Password
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" data-loading="true">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Account" asp-action="Register">
            <i class="fa-solid fa-user-plus me-1"></i>Register
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-outline-light btn-sm ms-1" asp-controller="Account" asp-action="Login">
            <i class="fa-solid fa-right-to-bracket me-1"></i>Login
        </a>
    </li>
}
</ul>
