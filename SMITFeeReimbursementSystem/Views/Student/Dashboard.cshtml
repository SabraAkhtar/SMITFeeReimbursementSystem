@using SMITFeeReimbursementSystem.Models
@using SMITFeeReimbursementSystem.Services
@{
    ViewData["Title"] = "My Dashboard";
    var user = ViewBag.User as ApplicationUser;
    var payments = ViewBag.Payments as List<Payment> ?? new();
    var refunds = ViewBag.Refunds as List<Refund> ?? new();
    var summaries = ViewBag.AttendanceSummaries as List<AttendanceSummary> ?? new();
    decimal threshold = ViewBag.EligibilityThreshold ?? 80m;

    var pendingPay = payments.Count(p => p.Status == PaymentStatus.Pending);
    var approvedPay = payments.Count(p => p.Status == PaymentStatus.Approved);
    var rejectedPay = payments.Count(p => p.Status == PaymentStatus.Rejected);
    var approvedRefunds = refunds.Count(r => r.RefundStatus == RefundStatus.Approved);
    var pendingRefunds = refunds.Count(r => r.RefundStatus == RefundStatus.Pending);
    var bestAttendance = summaries.Any() ? summaries.Max(s => s.AttendancePercentage) : 0m;
    var eligibleCourses = summaries.Count(s => s.AttendancePercentage >= threshold);
}

<partial name="_StatusMessage" />

@* ── Welcome Banner ── *@
<div class="mb-4 p-4" style="background:linear-gradient(135deg,#0f1923 0%,#1a2332 100%);border-radius:1.25rem;border:1px solid rgba(46,204,113,0.2);">
    <div class="row align-items-center g-3">
        <div class="col-auto">
            <div style="width:56px;height:56px;border-radius:50%;background:rgba(46,204,113,0.15);display:flex;align-items:center;justify-content:center;border:2px solid rgba(46,204,113,0.3);">
                <i class="fa-solid fa-user-graduate fa-xl" style="color:#2ecc71;"></i>
            </div>
        </div>
        <div class="col">
            <h4 class="mb-0 fw-bold text-white">Welcome back, @(user?.FullName ?? user?.Email ?? "Student")!</h4>
            <p class="mb-0" style="color:rgba(255,255,255,0.5);font-size:0.85rem;">
                <i class="fa-solid fa-id-card me-1"></i>Roll No: @(user?.RollNumber ?? "Not set")
                &nbsp;·&nbsp;
                <i class="fa-solid fa-envelope me-1"></i>@user?.Email
            </p>
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            <a asp-controller="Payments" asp-action="Submit" class="btn btn-sm fw-bold"
               style="background:#2ecc71;color:#fff;border:none;border-radius:0.5rem;padding:0.45rem 1rem;">
                <i class="fa-solid fa-upload me-1"></i>Submit Fee
            </a>
            <a href="https://lms.saylanimit.com/login" target="_blank" rel="noopener"
               class="btn btn-sm fw-bold"
               style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.2);border-radius:0.5rem;padding:0.45rem 1rem;">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>SMIT Portal
            </a>
        </div>
    </div>
</div>

@* ── Stats Cards ── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <div class="card-body p-3 text-center">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(245,158,11,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                    <i class="fa-solid fa-clock" style="color:#f59e0b;"></i>
                </div>
                <div style="font-size:1.8rem;font-weight:800;color:#f59e0b;line-height:1;">@pendingPay</div>
                <div class="text-muted" style="font-size:0.75rem;margin-top:0.2rem;">Pending Payments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <div class="card-body p-3 text-center">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(46,204,113,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                    <i class="fa-solid fa-circle-check" style="color:#2ecc71;"></i>
                </div>
                <div style="font-size:1.8rem;font-weight:800;color:#2ecc71;line-height:1;">@approvedPay</div>
                <div class="text-muted" style="font-size:0.75rem;margin-top:0.2rem;">Approved Payments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <div class="card-body p-3 text-center">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                    <i class="fa-solid fa-hand-holding-dollar" style="color:#3b82f6;"></i>
                </div>
                <div style="font-size:1.8rem;font-weight:800;color:#3b82f6;line-height:1;">@pendingRefunds</div>
                <div class="text-muted" style="font-size:0.75rem;margin-top:0.2rem;">Pending Refunds</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <div class="card-body p-3 text-center">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(139,92,246,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                    <i class="fa-solid fa-calendar-check" style="color:#8b5cf6;"></i>
                </div>
                <div style="font-size:1.8rem;font-weight:800;color:#8b5cf6;line-height:1;">@bestAttendance%</div>
                <div class="text-muted" style="font-size:0.75rem;margin-top:0.2rem;">Best Attendance</div>
            </div>
        </div>
    </div>
</div>

@* ── SMIT Portal Card ── *@
<div class="card mb-4" style="border-radius:1.25rem;background:linear-gradient(135deg,#0f1923 0%,#1a2332 60%,#0d2818 100%);border:1px solid rgba(46,204,113,0.3);overflow:hidden;box-shadow:0 8px 32px rgba(46,204,113,0.12);">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <div style="width:64px;height:64px;border-radius:18px;background:rgba(46,204,113,0.15);display:flex;align-items:center;justify-content:center;border:2px solid rgba(46,204,113,0.35);box-shadow:0 4px 16px rgba(46,204,113,0.2);">
                    <i class="fa-solid fa-graduation-cap fa-2x" style="color:#2ecc71;"></i>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="background:rgba(46,204,113,0.2);color:#2ecc71;border:1px solid rgba(46,204,113,0.4);padding:0.15rem 0.6rem;border-radius:50px;font-size:0.7rem;font-weight:700;letter-spacing:0.05em;">
                        OFFICIAL SMIT LMS
                    </span>
                </div>
                <h5 class="fw-bold mb-1" style="color:#fff;font-size:1.05rem;">Your Attendance is on SMIT Student Portal</h5>
                <p class="mb-0" style="color:rgba(255,255,255,0.55);font-size:0.82rem;line-height:1.5;">
                    <i class="fa-solid fa-circle-info me-1" style="color:#2ecc71;"></i>
                    Your <strong style="color:rgba(255,255,255,0.85);">official & complete attendance record</strong> is maintained on the SMIT LMS Portal. Click the button to check your attendance anytime.
                </p>
            </div>
            <div class="col-12 col-md-auto mt-1 mt-md-0">
                <a href="https://lms.saylanimit.com/login" target="_blank" rel="noopener"
                   class="btn fw-bold d-flex align-items-center gap-2 justify-content-center"
                   style="background:linear-gradient(135deg,#2ecc71,#27ae60);color:#fff;border:none;border-radius:0.75rem;padding:0.65rem 1.4rem;font-weight:700;box-shadow:0 4px 18px rgba(46,204,113,0.45);font-size:0.9rem;white-space:nowrap;">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    Check My Attendance
                </a>
                <div class="text-center mt-1" style="color:rgba(255,255,255,0.35);font-size:0.7rem;">
                    lms.saylanimit.com
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* ── Attendance Progress ── *@
    <div class="col-lg-6">
        <div class="card h-100 border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0" style="color:#0f1923;">
                        <i class="fa-solid fa-calendar-check me-2 text-primary"></i>Attendance Progress
                    </h6>
                    <a asp-controller="Attendance" asp-action="MyAttendance"
                       class="btn btn-sm btn-outline-primary" style="font-size:0.75rem;">View All</a>
                </div>

                @if (!summaries.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block" style="opacity:0.3;"></i>
                        <span style="font-size:0.85rem;">No attendance data yet</span>
                    </div>
                }
                else
                {
                    foreach (var s in summaries)
                    {
                        var eligible = s.AttendancePercentage >= threshold;
                        var pctColor = eligible ? "#2ecc71" : (s.AttendancePercentage >= 60m ? "#f59e0b" : "#ef4444");
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span style="font-size:0.85rem;font-weight:600;color:#0f1923;">@s.CourseName</span>
                                <span style="font-size:0.85rem;font-weight:800;color:@pctColor;">@s.AttendancePercentage%</span>
                            </div>
                            <div style="height:8px;border-radius:4px;background:#f1f5f9;overflow:hidden;">
                                <div style="height:100%;width:@(Math.Min(100,s.AttendancePercentage))%;background:@pctColor;border-radius:4px;transition:width 0.6s;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1" style="font-size:0.72rem;color:#94a3b8;">
                                <span>@s.PresentDays present · @s.AbsentDays absent</span>
                                @if (eligible)
                                {
                                    <span style="color:#2ecc71;"><i class="fa-solid fa-check me-1"></i>Refund eligible</span>
                                }
                                else
                                {
                                    <span>Need @(threshold)% for refund</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* ── Recent Payments ── *@
    <div class="col-lg-6">
        <div class="card h-100 border-0" style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0" style="color:#0f1923;">
                        <i class="fa-solid fa-receipt me-2 text-warning"></i>My Payments
                    </h6>
                    <a asp-controller="Payments" asp-action="MyPayments"
                       class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem;">View All</a>
                </div>

                @if (!payments.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-receipt fa-2x mb-2 d-block" style="opacity:0.3;"></i>
                        <span style="font-size:0.85rem;">No payments yet</span><br />
                        <a asp-controller="Payments" asp-action="Submit" class="btn btn-sm btn-primary mt-2">
                            Submit First Payment
                        </a>
                    </div>
                }
                else
                {
                    foreach (var p in payments.Take(4))
                    {
                        var (badgeClass, badgeIcon) = p.Status switch
                        {
                            PaymentStatus.Approved => ("text-success", "fa-circle-check"),
                            PaymentStatus.Rejected => ("text-danger", "fa-circle-xmark"),
                            _ => ("text-warning", "fa-clock")
                        };
                        <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                            <i class="fa-solid @badgeIcon @badgeClass fa-lg flex-shrink-0"></i>
                            <div class="flex-grow-1 overflow-hidden">
                                <div style="font-weight:600;font-size:0.85rem;color:#0f1923;" class="text-truncate">@p.Course.CourseName</div>
                                <div style="font-size:0.75rem;color:#94a3b8;">Rs. @p.Amount.ToString("N0") · @p.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                            </div>
                            @if (p.Status == PaymentStatus.Approved && p.Receipt != null)
                            {
                                <a asp-controller="Payments" asp-action="DownloadPdf" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-success flex-shrink-0" title="Download Receipt">
                                    <i class="fa-solid fa-file-pdf me-1"></i>PDF
                                </a>
                            }
                            @if (p.Status == PaymentStatus.Rejected)
                            {
                                <a asp-controller="Payments" asp-action="Submit"
                                   class="btn btn-sm btn-danger flex-shrink-0" title="Resubmit">
                                    <i class="fa-solid fa-rotate-right me-1"></i>Redo
                                </a>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@* ── Quick Actions ── *@
<div class="row g-3 mt-2">
    <div class="col-6 col-md-3">
        <a asp-controller="Payments" asp-action="Submit"
           class="card border-0 text-center p-3 text-decoration-none h-100"
           style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);transition:all 0.2s;"
           onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fa-solid fa-upload fa-xl mb-2" style="color:#2ecc71;"></i>
            <div style="font-weight:700;font-size:0.85rem;color:#0f1923;">Submit Fee</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Attendance" asp-action="MyAttendance"
           class="card border-0 text-center p-3 text-decoration-none h-100"
           style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);transition:all 0.2s;"
           onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fa-solid fa-calendar-check fa-xl mb-2" style="color:#3b82f6;"></i>
            <div style="font-weight:700;font-size:0.85rem;color:#0f1923;">My Attendance</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Refunds" asp-action="MyRefunds"
           class="card border-0 text-center p-3 text-decoration-none h-100"
           style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);transition:all 0.2s;"
           onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fa-solid fa-hand-holding-dollar fa-xl mb-2" style="color:#f59e0b;"></i>
            <div style="font-weight:700;font-size:0.85rem;color:#0f1923;">My Refunds</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="https://lms.saylanimit.com/login" target="_blank" rel="noopener"
           class="card border-0 text-center p-3 text-decoration-none h-100"
           style="border-radius:1rem;box-shadow:0 2px 12px rgba(0,0,0,0.06);transition:all 0.2s;background:linear-gradient(135deg,#0f1923,#1a2332);"
           onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fa-solid fa-graduation-cap fa-xl mb-2" style="color:#2ecc71;"></i>
            <div style="font-weight:700;font-size:0.85rem;color:#fff;">SMIT Portal</div>
        </a>
    </div>
</div>
